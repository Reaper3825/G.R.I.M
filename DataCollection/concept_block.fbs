// FlatBuffers schema for the GRIM concept-block dataset.
// Authoring, rendering, and span contract:
//   docs/GRIM_REASONING_DATA_CONTRACT.md
// Regenerate C++ with:
//   flatc --cpp --scoped-enums -o DataCollection DataCollection/concept_block.fbs
//
// `schema_version` is the dataset-level migration boundary. Additive table
// fields remain backward compatible; bump the version only when readers need
// explicit migration behavior.
namespace GRIMConcept;

table EvidenceCondition {
    predicate: string;
    subject: string;
    target: string;
}

table SuccessCriterion {
    criterion: string;
    legacy_evidence: string; // Original slot: migration input only, never written.
    evidence: EvidenceCondition;
}

table Constraint {
    constraint: string;
    evidence: EvidenceCondition;
}

table Goal {
    target_state: string;
    success_criteria: [SuccessCriterion];
    legacy_constraints: [string]; // Original slot: read-only compatibility.
    constraints: [Constraint];
}

table ConceptBlock {
    id: string;
    name: string;
    prompt: string;
    intermediates: [string];
    answer: string;
    explanation: [string];
    retired_payload: [ubyte] (deprecated); // Reserved field slot; never read or written.
    intermediate_count: int;
    step_index: [int];
    format_type: string;
    source_sequence_id: string;
    timestamp: long;
    goal: Goal;
    raw: string;
    knowns: [string];
    unknowns: [string];
    // Appended for binary compatibility with existing concept_blocks.fb files.
    determine: string;
    execute: string;
    update: string;
    define: string;
}

table ConceptBlockDataset {
    schema_version: uint = 1;
    blocks: [ConceptBlock];
}

root_type ConceptBlockDataset;
file_identifier "GRCB";
file_extension "fb";
