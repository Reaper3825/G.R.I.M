  "description": "GRIM Web Data Collection Configuration - Intelligent Multi-Tier Strategy",
  "logging": {
    "level": "INFO",
    "log_file": "logs/data_collection.log",
    "log_statistics": true,
    "log_to_console": true,
    "verbose": true
  },
  "parsing_settings": {
    "extract_entities": true,
    "extract_keywords": true,
    "extract_topics": true,
    "max_tokens_per_example": 2048,
    "overlap_tokens": 128,
    "parsing_strategies": [
      {
        "enabled": true,
        "format": "instruction_following",
        "name": "code_documentation",
        "triggers": [
          "```",
          "def ",
          "class ",
          "function"
        ]
      },
      {
        "enabled": true,
        "format": "question_answer",
        "name": "qa_generation",
        "triggers": [
          "?",
          "how to",
          "what is",
          "why"
        ]
      },
      {
        "enabled": true,
        "format": "text_completion",
        "min_length": 500,
        "name": "summarization"
      },
      {
        "enabled": true,
        "format": "text_completion",
        "name": "next_sentence"
      }
    ]
  },
  "safety": {
    "max_concurrent_domains": 3,
    "max_file_size_mb": 10,
    "max_redirects": 5,
    "min_request_interval_ms": 1000,
    "respect_robots_txt": true,
    "timeout_per_request_sec": 30
  },
  "storage_settings": {
    "compression": "zlib",
    "create_splits": true,
    "file_naming": {
      "include_checksum": true,
      "include_timestamp": true,
      "pattern": "{source_type}_{date}_{session_id}.gwbt"
    },
    "index_enabled": true,
    "output_dir": "data/raw",
    "output_format": "flatbuffer",
    "parsed_dir": "data/parsed",
    "test_ratio": 0.1,
    "train_ratio": 0.8,
    "val_ratio": 0.1,
    "verified_dir": "data/verified"
