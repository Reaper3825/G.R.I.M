  "verification_settings": {
    "enabled": true,
    "min_reliability_threshold": 0.8,
    "cross_reference_enabled": true,
    "min_cross_references": 2,
    
    "domain_whitelist": [
      "github.com",
      "arxiv.org",
      "wikipedia.org",
      "stackoverflow.com",
      "huggingface.co",
      "python.org",
