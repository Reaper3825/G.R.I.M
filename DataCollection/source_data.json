      "ncbi.nlm.nih.gov",
      "ark.intel.com",
      "nvidia.com",
      "techpowerup.com",
      "wikichip.org",
      "developer.mozilla.org",
      "doc.rust-lang.org",
      "golang.org",
      "docs.microsoft.com",
      "glottolog.org",
      "english-corpora.org",
      "wordnik.com",
      "americanrhetoric.com",
      "avalon.law.yale.edu",
      "owl.purdue.edu",
      "writingcenter.unc.edu",
      "earlymoderntexts.com",
      "philsci-archive.pitt.edu",
      "openstax.org",
      "openslr.org",
      "datashare.ed.ac.uk",
      "commonvoice.mozilla.org",
      "classics.mit.edu",
      "openlogicproject.org",
      "doabooks.org",
      "jstor.org",
      "public.oed.com",
      "dictionary.cambridge.org",
      "bartleby.com",
      "chicagomanualofstyle.org",
      "nature.com",
      "sciencedirect.com",
      "academic.oup.com",
      "cambridge.org",
      "archive.org",
      "muse.jhu.edu",
      "linguisticsociety.org",
      "quickanddirtytips.com",
      "merriam-webster.com",
      "springer.com",
      "oxfordhandbooks.com"
    ],
    
    "domain_blacklist": [
      "example.com",
      "spam.com",
      "ads.com"
    ],
    
    "content_quality_checks": {
      "min_length": 100,
      "max_length": 50000,
      "min_words": 20,
      "check_grammar": true,
      "check_encoding": true,
      "detect_spam": true,
      "detect_duplicates": true
    }
  },
  
  "parsing_settings": {
    "max_tokens_per_example": 2048,
    "overlap_tokens": 128,
    "extract_entities": true,
    "extract_keywords": true,
    "extract_topics": true,
    
    "parsing_strategies": [
      {
        "name": "code_documentation",
        "enabled": true,
        "triggers": ["```", "def ", "class ", "function"],
        "format": "instruction_following"
      },
      {
        "name": "qa_generation",
        "enabled": true,
        "triggers": ["?", "how to", "what is", "why"],
        "format": "question_answer"
      },
      {
        "name": "summarization",
        "enabled": true,
        "min_length": 500,
        "format": "text_completion"
      },
      {
        "name": "next_sentence",
        "enabled": true,
        "format": "text_completion"
      }
    ]
  },
  
  "storage_settings": {
    "output_format": "flatbuffer",
    "compression": "zlib",
    "output_dir": "data/raw",
    "verified_dir": "data/verified",
    "parsed_dir": "data/parsed",
    
    "file_naming": {
      "pattern": "{source_type}_{date}_{session_id}.gwbt",
      "include_timestamp": true,
      "include_checksum": true
    },
    
    "index_enabled": true,
    "create_splits": true,
    "train_ratio": 0.8,
    "val_ratio": 0.1,
    "test_ratio": 0.1
  },
  
  "logging": {
    "level": "INFO",
    "log_file": "logs/data_collection.log",
    "verbose": true,
    "log_to_console": true,
    "log_statistics": true
  },
  
  "safety": {
    "respect_robots_txt": true,
    "min_request_interval_ms": 1000,
    "max_concurrent_domains": 3,
    "max_file_size_mb": 10,
    "timeout_per_request_sec": 30,
    "max_redirects": 5
  }
}
