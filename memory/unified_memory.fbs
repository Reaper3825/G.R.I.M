// FlatBuffers schema for GRIM unified memory system
namespace GRIM.Memory;

enum CommType : byte {
    COMMAND = 0,
    QUESTION = 1,
    BANTER = 2,
    UNKNOWN = 3
}

enum MemoryDomain : byte {
    BASE = 0,
    FIELD = 1,
    USER = 2
}

enum TypeTag : byte {
        INT = 0,
        FLOAT = 1,
        STRING = 2,
        BOOL = 3
}

enum ContextType : byte {
    CONVERSATION = 0,
    WAKE = 1,
 DEV_MODE = 2
}

enum Modality : byte {
    TEXT = 0,
    AUDIO = 1,
    VISION = 2,
    SENSOR = 3
}

table MemoryRecord {
    id:ulong;
    timestamp:ulong;
    domain:MemoryDomain;
    type:TypeTag;
    context:ContextType;
    comm_type:CommType;
    modality:Modality;
    raw:string;
    normalized:string;
    tags:[string];
    confidence:float;
    importance:float = 1.0;
    recency_weight:float = 1.0;
    embedding:[float];
    parent_id:ulong = 0;
    related_ids:[ulong];
}

table IndexEntry {
    id:ulong;
    offset:ulong;
    embedding:[float];
    type:TypeTag;
    domain:MemoryDomain;
    timestamp:ulong;
    confidence:float;
    tags:[string];
}

table TagIndex {
    tag:string;
    memory_ids:[ulong];
}

table MemoryMetadata {
    schema_version:uint = 1;
    build_time:ulong;
    record_count:ulong;
    total_size_bytes:ulong;
}

table MemoryStore {
    metadata:MemoryMetadata;
    records:[MemoryRecord];
    index:[IndexEntry];
    tag_index:[TagIndex];
}

root_type MemoryStore;
