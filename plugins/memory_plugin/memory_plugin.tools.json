{
  "schema_version": 2,
  "api_version": 1572864,
  "provider": "Memory Plugin",
  "version": "1.0.0",
  "tools": [
    {
      "tool_id": "remember",
      "argument_format": "raw_text",
      "category": "action",
      "description": "Stage manual information in the provider memory pipeline",
      "is_informational": false,
      "needs_confirmation": true,
      "parameters": [
        {
          "description": "Original manual memory text staged in the host rotation pipeline",
          "name": "text",
          "required": true,
          "type": "string"
        }
      ],
      "short_description": "Stage supplied information for the provider memory pipeline",
      "usage": "remember <text>"
    },
    {
      "tool_id": "recall",
      "argument_format": "raw_text",
      "category": "information",
      "description": "Retrieve information from memory",
      "is_informational": true,
      "needs_confirmation": false,
      "parameters": [
        {
          "description": "Unmodified query for the provider memory search",
          "name": "query",
          "required": true,
          "type": "string"
        }
      ],
      "short_description": "Retrieve stored information matching the supplied memory query",
      "usage": "recall <query>"
    },
    {
      "tool_id": "memory.retrieve",
      "argument_format": "json",
      "category": "information",
      "description": "Retrieve ranked memory and lookup diagnostics for the orchestrator",
      "usage": "memory.retrieve",
      "usage_type": 2,
      "is_informational": false,
      "needs_confirmation": false,
      "argument_schema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string"
          },
          "nlp_category": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "prompt",
          "nlp_category",
          "limit"
        ]
      }
    }
  ]
}
