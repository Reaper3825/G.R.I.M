cmake_minimum_required(VERSION 3.22)

if(NOT DEFINED PLUGIN_FILE OR NOT DEFINED DEPLOY_DIR OR
   "${PLUGIN_FILE}" STREQUAL "" OR "${DEPLOY_DIR}" STREQUAL "")
    message(FATAL_ERROR "PLUGIN_FILE and DEPLOY_DIR are required")
endif()
if(NOT EXISTS "${PLUGIN_FILE}" OR IS_DIRECTORY "${PLUGIN_FILE}")
    message(FATAL_ERROR "Completed plugin output is missing: ${PLUGIN_FILE}")
endif()

get_filename_component(_name "${PLUGIN_FILE}" NAME)
if(PLUGIN_RUNTIME_DLLS)
    get_filename_component(_stem "${PLUGIN_FILE}" NAME_WLE)
    set(_runtime_dir "${DEPLOY_DIR}/dependencies/${_stem}")
    file(MAKE_DIRECTORY "${_runtime_dir}")
    foreach(_dependency IN LISTS PLUGIN_RUNTIME_DLLS)
        get_filename_component(_dependency_name "${_dependency}" NAME)
        file(COPY_FILE "${_dependency}" "${_runtime_dir}/${_dependency_name}" ONLY_IF_DIFFERENT)
    endforeach()
endif()
function(publish_plugin_file source destination)
    get_filename_component(source "${source}" ABSOLUTE)
    get_filename_component(destination "${destination}" ABSOLUTE)
    if(source STREQUAL destination)
        return()
    endif()
    file(SHA256 "${source}" source_hash)
    if(EXISTS "${destination}" AND NOT IS_DIRECTORY "${destination}")
        file(SHA256 "${destination}" destination_hash)
        if(source_hash STREQUAL destination_hash)
            return()
        endif()
    endif()

    file(MAKE_DIRECTORY "${DEPLOY_DIR}")
    # Reconciliation ignores staging files until the final rename.
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
    set(pending "${destination}.${nonce}.pending")
    file(COPY_FILE "${source}" "${pending}" RESULT copy_result)
    if(NOT copy_result STREQUAL "0")
        message(FATAL_ERROR "Cannot stage ${destination}: ${copy_result}")
    endif()
    file(SHA256 "${pending}" pending_hash)
    if(NOT source_hash STREQUAL pending_hash)
        message(FATAL_ERROR "Source changed while staging: ${source}")
    endif()
    file(RENAME "${pending}" "${destination}" RESULT rename_result)
    if(NOT rename_result STREQUAL "0")
        message(FATAL_ERROR "Cannot publish ${destination}: ${rename_result}")
    endif()
    message(STATUS "Deployed plugin file: ${destination}")
endfunction()

if(PLUGIN_MANIFEST)
    get_filename_component(_stem "${PLUGIN_FILE}" NAME_WLE)
    publish_plugin_file("${PLUGIN_MANIFEST}" "${DEPLOY_DIR}/${_stem}.tools.json")
endif()
publish_plugin_file("${PLUGIN_FILE}" "${DEPLOY_DIR}/${_name}")
