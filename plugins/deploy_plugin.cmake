cmake_minimum_required(VERSION 3.22)

if(NOT DEFINED PLUGIN_FILE OR NOT DEFINED DEPLOY_DIR OR
   "${PLUGIN_FILE}" STREQUAL "" OR "${DEPLOY_DIR}" STREQUAL "")
    message(FATAL_ERROR "PLUGIN_FILE and DEPLOY_DIR are required")
endif()
if(NOT EXISTS "${PLUGIN_FILE}" OR IS_DIRECTORY "${PLUGIN_FILE}")
    message(FATAL_ERROR "Completed plugin output is missing: ${PLUGIN_FILE}")
endif()

get_filename_component(_name "${PLUGIN_FILE}" NAME)
get_filename_component(_stem "${PLUGIN_FILE}" NAME_WLE)
set(_plugin_dir "${DEPLOY_DIR}/${_stem}")
file(MAKE_DIRECTORY "${_plugin_dir}")
file(LOCK "${_plugin_dir}/.deploy.lock" TIMEOUT 30)

set(_sources "${PLUGIN_FILE}")
set(_destinations "${_plugin_dir}/${_name}")
if(PLUGIN_MANIFEST)
    list(APPEND _sources "${PLUGIN_MANIFEST}")
    list(APPEND _destinations "${_plugin_dir}/${_stem}.tools.json")
endif()
set(_runtime_dir "${_plugin_dir}/dependencies")
set(_runtime_names)
foreach(dependency IN LISTS PLUGIN_RUNTIME_DLLS)
    get_filename_component(name "${dependency}" NAME)
    if(name IN_LIST _runtime_names)
        message(FATAL_ERROR "Duplicate plugin dependency: ${name}")
    endif()
    list(APPEND _runtime_names "${name}")
    list(APPEND _sources "${dependency}")
    list(APPEND _destinations "${_runtime_dir}/${name}")
endforeach()

# Verify all inputs before staging files.
set(_changed)
list(LENGTH _sources _count)
math(EXPR _last "${_count} - 1")
foreach(index RANGE ${_last})
    list(GET _sources ${index} source)
    list(GET _destinations ${index} destination)
    if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
        message(FATAL_ERROR "Plugin deployment input is missing: ${source}")
    endif()
    file(SHA256 "${source}" source_hash)
    set("_hash_${index}" "${source_hash}")
    if(EXISTS "${destination}" AND NOT IS_DIRECTORY "${destination}")
        file(SHA256 "${destination}" destination_hash)
        if(source_hash STREQUAL destination_hash)
            continue()
        endif()
    endif()
    list(APPEND _changed ${index})
endforeach()

set(_obsolete)
file(GLOB _deployed_dependencies LIST_DIRECTORIES FALSE "${_runtime_dir}/*.dll")
foreach(dependency IN LISTS _deployed_dependencies)
    get_filename_component(name "${dependency}" NAME)
    if(NOT name IN_LIST _runtime_names)
        list(APPEND _obsolete "${dependency}")
    endif()
endforeach()

# Stage every changed file before touching the live bundle.
foreach(index IN LISTS _changed)
    list(GET _sources ${index} source)
    list(GET _destinations ${index} destination)
    get_filename_component(directory "${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    set(pending "${destination}.pending")
    file(COPY_FILE "${source}" "${pending}")
    file(SHA256 "${pending}" pending_hash)
    if(NOT pending_hash STREQUAL _hash_${index})
        message(FATAL_ERROR "Source changed while staging: ${source}")
    endif()
endforeach()

foreach(index IN LISTS _changed)
    list(GET _destinations ${index} destination)
    file(RENAME "${destination}.pending" "${destination}")
    message(STATUS "Deployed plugin file: ${destination}")
endforeach()
foreach(dependency IN LISTS _obsolete)
    file(REMOVE "${dependency}")
    if(EXISTS "${dependency}")
        message(FATAL_ERROR "Cannot remove obsolete plugin dependency: ${dependency}")
    endif()
endforeach()
