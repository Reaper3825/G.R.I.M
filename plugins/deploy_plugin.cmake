cmake_minimum_required(VERSION 3.22)

if(NOT DEFINED PLUGIN_FILE OR NOT DEFINED DEPLOY_DIR OR
   "${PLUGIN_FILE}" STREQUAL "" OR "${DEPLOY_DIR}" STREQUAL "")
    message(FATAL_ERROR "PLUGIN_FILE and DEPLOY_DIR are required")
endif()
if(NOT EXISTS "${PLUGIN_FILE}" OR IS_DIRECTORY "${PLUGIN_FILE}")
    message(FATAL_ERROR "Completed plugin output is missing: ${PLUGIN_FILE}")
endif()

get_filename_component(_name "${PLUGIN_FILE}" NAME)
get_filename_component(_source "${PLUGIN_FILE}" ABSOLUTE)
get_filename_component(_destination "${DEPLOY_DIR}/${_name}" ABSOLUTE)
if(_source STREQUAL _destination)
    return()
endif()
file(SHA256 "${_source}" _source_hash)
if(EXISTS "${_destination}" AND NOT IS_DIRECTORY "${_destination}")
    file(SHA256 "${_destination}" _destination_hash)
    if(_source_hash STREQUAL _destination_hash)
        return()
    endif()
endif()

file(MAKE_DIRECTORY "${DEPLOY_DIR}")
# The loader only scans native library extensions. Stage beside the destination
# with a different extension, then replace by same-filesystem rename.
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _nonce)
set(_pending "${_destination}.${_nonce}.pending")
file(COPY_FILE "${_source}" "${_pending}" RESULT _copy_result)
if(NOT _copy_result STREQUAL "0")
    message(FATAL_ERROR "Cannot stage plugin ${_name}: ${_copy_result}")
endif()
file(SHA256 "${_pending}" _pending_hash)
if(NOT _source_hash STREQUAL _pending_hash)
    message(FATAL_ERROR "Plugin changed while staging: ${_source}")
endif()
file(RENAME "${_pending}" "${_destination}" RESULT _rename_result)
if(NOT _rename_result STREQUAL "0")
    message(FATAL_ERROR "Cannot publish plugin ${_name}: ${_rename_result}")
endif()
message(STATUS "Deployed plugin: ${_destination}")
