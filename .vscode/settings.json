    // ──────────────────────────────────────────────────────────────
    // 🧩 GRIM-only extras — hide external git repos from Source Control
    // ──────────────────────────────────────────────────────────────
    "git.ignoredRepositories": [
        "D:/G.R.I.M/external"
    ],

    // Hide all .git folders inside external/ and build artifacts
    "files.exclude": {
        "**/external/**/.git": true,
        "**/build/**": true,
        "**/out/build/**": true,
        "**/.vs/**": true,
        "**/.vscode/.browse.VC.db*": true,
        "**/*.obj": true,
        "**/*.pdb": true,
        "**/*.ilk": true
    },

    // Stop VS Code from auto-detecting nested repos
    "git.autoRepositoryDetection": false,
    "makefile.makefilePath": "D:\\G.R.I.M\\CMakeLists.txt",
    "python.analysis.autoImportCompletions": true,
    "python.analysis.typeCheckingMode": "standard"
}
