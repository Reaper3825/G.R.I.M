{
    "cmake.sourceDirectory": "D:/G.R.I.M",

    // MS C/C++ extension (ms-vscode.cpptools) — use compile_commands.json
    "C_Cpp.default.compileCommands": "D:/G.R.I.M/build/compile_commands.json",
    
    // Exclude dependency folders from IntelliSense indexing
    "C_Cpp.files.exclude": {
        "**/vcpkg_installed/**": true,
        "**/external/**": true,
        "**/deps/**": true,
        "**/build/**": true,
        "**/out/**": true,
        "**/.venv/**": true,
        "**/venv_rl/**": true,
        "**/openal-soft/**": true,
        "**/VCTK-final/**": true,
        "**/.git/**": true,
        "**/.vs/**": true,
        "**/.vscode/.browse.VC.db*": true
    },
    
    // Exclude from search
    "search.exclude": {
        "**/vcpkg_installed/**": true,
        "**/external/**": true,
        "**/deps/**": true,
        "**/build/**": true,
        "**/out/**": true,
        "**/.venv/**": true,
        "**/venv_rl/**": true,
        "**/openal-soft/**": true,
        "**/VCTK-final/**": true
    },
    
    // Exclude from file watcher (improves performance)
    "files.watcherExclude": {
        "**/vcpkg_installed/**": true,
        "**/external/**": true,
        "**/deps/**": true,
        "**/build/**": true,
        "**/out/**": true,
        "**/.venv/**": true,
        "**/venv_rl/**": true,
        "**/openal-soft/**": true,
        "**/VCTK-final/**": true
    },

    // clangd extension — point to the same database
    "clangd.arguments": [
        "--compile-commands-dir=D:/G.R.I.M/build",
        "--header-insertion=never",
        "--cross-file-rename",
        "--query-driver=**",
        "--background-index=false"
    ],

    // Optional: disable cpptools IntelliSense squiggles if you prefer clangd
    // "C_Cpp.intelliSenseEngine": "Disabled",

    "files.associations": {
