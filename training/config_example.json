{
  "description": "GRIM Self-Training Pipeline Configuration",
  "version": "1.0",
  
  "collector": {
    "output_dir": "data/raw",
    "max_entries": 100,
    "timeout": 30,
    "save_as_jsonl": true,
    "keyword_filters": [
      "AI",
      "machine learning",
      "neural network",
      "deep learning",
      "artificial intelligence"
    ],
    "sources_file": "config/data_sources.json"
  },
  
  "verifier": {
    "input_dir": "data/raw",
    "output_dir": "data/verified",
    "min_reliability": 0.8,
    "cross_check": true,
    "min_cross_refs": 2,
    "whitelist_file": "config/domain_whitelist.txt",
    "blacklist_file": "config/domain_blacklist.txt",
    "source_type_weights": {
      "news_api": 0.7,
      "github": 0.9,
      "tech_docs": 0.95
    }
  },
  
  "parser": {
    "input_dir": "data/verified",
    "output_dir": "data/parsed",
    "max_tokens": 2048,
    "extract_entities": true,
    "extract_keywords": true,
    "compute_embeddings": false,
    "save_as_flatbuffer": false,
    "strategy": "instruction",
    "tokenizer_path": "models/tokenizer.json"
  },
  
  "trainer": {
    "input_dir": "data/parsed",
    "model_dir": "models",
    "base_model_path": "models/grim_user_current.gguf",
    "output_adapter_path": "models/grim_user_temp.pt",
    
    "learning_rate": 0.00001,
    "num_epochs": 2,
    "batch_size": 4,
    "max_steps": -1,
    "warmup_ratio": 0.1,
    
    "use_lora": true,
    "lora_rank": 8,
    "lora_alpha": 16.0,
    "target_modules": ["q_proj", "v_proj"],
    
    "validation_split": 0.1,
    "eval_steps": 100,
    
    "log_dir": "logs/training",
    "save_checkpoints": true,
    "checkpoint_steps": 500
  },
  
  "deployment": {
    "temp_adapter_path": "models/grim_user_temp.pt",
    "current_model_path": "models/grim_user_current.gguf",
    "archive_dir": "models/archive",
    "test_prompts_path": "data/test_prompts.json",
    
    "min_accuracy": 0.85,
    "run_tests": true,
    "cleanup": true
  },
  
  "auto_deploy": true,
  "stop_on_error": true,
  "log_file": "logs/pipeline.log"
}
