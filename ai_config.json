            "atom_stats_interval": 200,
            "atom_stats_max_seqs": 32,
            "attention_diagnostics": {
                "enabled": false,
                "head": 0,
                "layer": -1
            },
            "attention_dropout": 0.12,
            "auto_stop": {
                "enabled": true,
                "high_loss_patience": 12,
                "high_loss_threshold": 6.0,
                "plateau_min_delta": 0.004,
                "plateau_patience": 18
            },
            "batch_size": 8,
            "batch_strategy": "RANDOM",
            "checkpoint_interval": 2000,
            "cosine_decay": {
                "enabled": true,
                "min_lr": 6e-05
            },
            "cuda_execution": {
                "disable_async_frees": false,
                "single_stream_mode": false,
                "synchronize_after_kernels": true
