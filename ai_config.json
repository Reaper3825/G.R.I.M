            "epochs": 25,
            "force_rebuild_vocab": true,
            "generation": {
                "do_sample": true,
                "enable_scratchblock_reasoning": true,
                "frequency_penalty": 0.0,
                "max_new_tokens": 128,
                "min_new_tokens": 1,
                "min_p": 0.0,
                "no_repeat_ngram_size": 3,
                "presence_penalty": 0.0,
                "repetition_penalty": 1.1,
                "repetition_penalty_window": 64,
                "strategy": "greedy",
                "temperature": 0.8,
                "top_k": 50,
                "top_p": 0.9,
                "typical_p": 1.0
            },
            "gradient_accumulation_steps": 2,
            "gradient_clip": 1.0,
            "guess_aux": {
                "enabled": false,
                "lambda": 0.25,
                "min_confidence": 0.7
            },
            "hardcoded_hidden_states": {
                "enabled": false,
                "log_every_n_batches": 1,
                "pattern": "random_centered"
            },
            "layer_scale": {
                "enabled": false,
                "init_value": 1.0
            },
            "learning_rate": 0.0006,
            "lm_head_centering": {
                "center_encoder_residuals": true,
                "center_hidden_states": true,
                "center_logits": false,
                "enabled": true,
                "pc1_power_iters": 5,
                "project_out_pc1": true
            },
            "log_interval": 25,
            "log_recorder": {
                "default_level": "Info",
                "enabled": true,
                "layers": {
                    "attention": true,
                    "embedding": true,
                    "encoding": true,
                    "feed_forward": true,
                    "residual": true,
                    "rms_norm": true,
                    "serialization": true
                },
                "modules": {
                    "Activations": "WARN",
                    "BackwardPass": "WARN",
                    "Checkpoint": "Info",
                    "Custom": "Info",
                    "DataLoader": "Info",
                    "ForwardPass": "WARN",
                    "GuessCache": "Info",
                    "Inference": "Info",
                    "LogRecorder": "Info",
                    "Optimizer": "Info",
                    "Scheduler": "Info",
                    "StreamController": "Info",
                    "Training": "Info",
                    "TrainingOrchestrator": "Info",
                    "Validation": "Info"
                }
            },
            "logit_update_trace": {
                "enabled": false,
                "interval": 50
