                "max_step_window": 50
            },
            "stability_overrides": {
                "batch_size": 8,
                "clip_per_token": 0.02,
                "lr_min": 0.0005,
                "max_seq_len": 1024
            },
            "stability_overrides_enabled": false,
            "telemetry_control": {
                "accumulation_guard": {
                    "loss_threshold": 0.01,
                    "max_consecutive_zero_grad_steps": 0,
