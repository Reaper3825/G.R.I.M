{
    "api_keys": {
        "azure": "",
        "elevenlabs": "",
        "openai": ""
    },
    "backend": "ollama",
    "conversation_history_size": 10,
    "default_model": "llama3.1:8b",
    "grim_text_url": "http://127.0.0.1:11435",
    "localai_url": "http://127.0.0.1:8080/v1",
    "max_tokens": 256,
    "model_path": "resources/models/GRIM-text/training/checkpoints/model_embeddings.npy",
    "ollama_options": {
        "low_vram": false,
        "num_batch": 512,
        "num_ctx": 4096,
        "num_gpu": 10,
        "num_predict": 512,
        "num_thread": 8,
        "repeat_penalty": 1.1,
        "temperature": 0.7,
        "top_k": 40,
        "top_p": 0.9,
        "use_mlock": false,
        "use_mmap": true
    },
    "ollama_url": "http://127.0.0.1:11434",
    "paths": {
        "grim_text": {
            "checkpoints": "D:/G.R.I.M/resources/models/GRIM-text/checkpoints",
            "collected": "D:/G.R.I.M/resources/models/GRIM-text/data/collected",
            "collector_log": "D:/G.R.I.M/resources/models/GRIM-text/training/logs/collector.log",
            "logs": "D:/G.R.I.M/resources/models/GRIM-text/training/logs",
            "merge_checkpoints_exe": "D:/G.R.I.M/resources/models/GRIM-text/DataCollection/Release/merge_checkpoints.exe",
            "model": "D:/G.R.I.M/resources/models/GRIM-text/grim_text.bin",
            "source_config": "D:/G.R.I.M/DataCollection/source_data.json",
            "training_data": "D:/G.R.I.M/resources/models/GRIM-text/training/data/training_data.grmt",
            "training_status": "D:/G.R.I.M/resources/models/GRIM-text/training\\training_status.fb",
            "verified": "D:/G.R.I.M/resources/models/GRIM-text/data/verified",
            "vocab": "D:/G.R.I.M/resources/models/GRIM-text/training/models/vocab.bin"
        }
    },
    "personality": {
        "custom_prompt": "You are GRIM. Be brief and direct. Give concise answers without unnecessary elaboration. Keep responses under 2 sentences when possible.",
        "use_custom_prompt": true
    },
    "silence_threshold": 0.02,
    "silence_timeout_ms": 4000,
    "tokenizer_path": "resources/models/GRIM-text/training/models/vocab.txt",
    "training": {
        "config": {
            "log_interval": 1,
            "batch_size": 4,
            "epochs": 1,
            "gradient_clip": 10.0,
            "learning_rate": 3e-05,
            "max_seq_len": 2048,
            "use_flash_attention": true,
            "use_gpu": true,
            "warmup_steps": 50,
            "dynamic_lr": {
                "enabled": true,
                "auto_generate": true
            },
            "soft_restart": {
                "enabled": true,
                "loss_increase_threshold": 0.2
            },
            "activation_quantization": {
                "enabled": true,
                "apply_to_embeddings": true,
                "apply_to_encoder_outputs": true,
                "apply_to_layer_caches": true,
                "apply_to_qkv_cache": true,
                "apply_to_logits": true,
                "scale": 0.0625,
                "clip_min": -127.0,
                "clip_max": 127.0,
                "zero_point": 0,
                "symmetric": true
            },
            "auto_stop": {
                "enabled": true,
                "plateau_patience": 8,
                "plateau_min_delta": 0.002,
                "high_loss_threshold": 10.5,
                "high_loss_patience": 5
            },
            "micro_validation": {
                "enabled": true,
                "interval": 200,
                "batch_limit": 5,
                "min_step": 150,
                "prefer_short": true
            }
        },
        "server_host": "127.0.0.1",
        "server_port": 11436
    },
    "ui": {
        "font_name": "DejaVuSans-Bold",
        "font_size": 16
    },
    "vision_model": "llama3.2-vision:11b",
    "voice": {
        "available_speakers": [
            "default",
            "p226",
            "grim"
        ],
        "confidence_threshold": 0.6,
        "coqui": {
            "model": "tts_models/en/vctk/vits",
            "speaker": "p226"
        },
        "engine": "coqui",
        "filter_low_confidence": true,
        "input_device_index": -1,
        "local_engine": "en_US-amy-medium.onnx",
        "max_commands_per_input": 3,
        "mode": "local",
        "require_multi_command_confirmation": true,
        "rules": {
            "banter": "coqui",
            "reminder": "coqui",
            "startup": "coqui",
            "summary": "coqui"
        },
        "sapi": {
            "voice": "en_US-amy-medium.onnx"
        },
        "silence_threshold": 0.015,
        "silence_timeout_ms": 1200,
        "speaker": "grim",
        "speed": 1.5
    },
    "whisper": {
        "beam_size": 5,
        "best_of": 5,
        "entropy_threshold": 2.4,
        "initial_prompt": "Voice commands: open notepad, close window, show time, list directory",
        "language": "en",
        "logprob_threshold": -1.0,
        "max_len": 1,
        "max_listening_ms": 10000,
        "min_silence_ms": 1200,
        "min_speech_ms": 500,
        "no_speech_threshold": 0.6,
        "sampling_strategy": "beam",
        "silence_threshold": 0.02,
        "suppress_blank": true,
        "temperature": 0.2,
        "whisper_model": "ggml-base.en.bin"
    },
    "whisper_language": "en",
    "whisper_max_tokens": 32
}
