                "enabled": true,
                "max_atoms": 8192
            },
            "scratch_blocks": {
                "enabled": true,
                "max_tokens_per_block": 1024,
                "num_blocks": 4,
                "use_write_combined": true
            },
            "seed": 1,
            "shuffle": {
                "enabled": true,
                "epochs": 1
            },
            "single_batch": {
                "enabled": false,
                "max_steps": 1000
            },
            "soft_restart": {
                "cooldown_steps": 200,
                "enabled": false,
