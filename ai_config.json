            "loss": {
                "class_balanced": {
                    "beta": 0.5,
                    "enabled": false
                },
                "distillation": {
                    "enabled": false,
                    "lambda": 0.5,
                    "temperature": 1.0
                },
                "entropy_reg": {
                    "enabled": false,
                    "lambda": 0.0
                },
                "focal": {
                    "alpha": 1.0,
                    "enabled": false,
                    "gamma": 0.0
                },
                "label_smoothing": {
                    "enabled": true,
                    "epsilon": 0.1
                },
                "masking": {
                    "enabled": true,
                    "tag": ""
                },
                "preference": {
                    "beta": 0.1,
                    "enabled": false
                }
