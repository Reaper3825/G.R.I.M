            "timeout_ms": 60000,
            "max_input_chars": 3000,
            "skip_already_structured": true,
            "max_entries_per_run": 0
        }
    },
    "default_model": "llama3.1:8b",
    "grim_text_url": "http://127.0.0.1:11435",
    "localai_url": "http://127.0.0.1:8080/v1",
    "max_tokens": 256,
    "mmo": {
        "enabled": false,
        "mode": "shadow",
        "model_loader": {
            "hot_ttl_cap_ms": 300000,
            "idle_ttl_ms": 60000,
            "load_timeout_ms": 30000,
            "use_degrade_step_ms": 5000
        },
        "orchestrator": {
            "correction_output_path": "correction_tuples.jsonl",
            "generate_timeout_ms": 30000,
            "max_submodels_per_request": 1,
            "route_timeout_ms": 10000,
            "synthesize_timeout_ms": 10000
        },
        "router": {
            "backend_type": "grim_text_server",
            "description": "Primary router model — routes requests and synthesizes sub-model outputs",
            "estimated_ram_mb": 0,
            "estimated_vram_mb": 2048,
            "hard_copy_path": "",
            "id": "grim-text-router",
            "lora_path": "",
            "model_path": "resources/models/GRIM-text/grim_text.bin",
            "name": "GRIM-text Router",
            "subject": "general",
            "subject_tags": [
                "general",
                "routing",
                "synthesis"
            ],
            "url": "http://127.0.0.1:11435",
            "usage_weight": 1.0,
            "version": "1.0"
        },
        "sub_models": []
    },
    "ollama_options": {
        "low_vram": false,
        "num_batch": 512,
        "num_ctx": 4096,
        "num_gpu": 10,
        "num_predict": 512,
        "num_thread": 8,
        "repeat_penalty": 1.1,
        "temperature": 0.7,
        "top_k": 40,
        "top_p": 0.9,
        "use_mlock": false,
        "use_mmap": true
    },
    "ollama_url": "http://127.0.0.1:11434",
    "paths": {
        "grim_text": {
            "checkpoints": "resources/models/GRIM-text/checkpoints",
            "collected": "resources/models/GRIM-text/data/collected",
            "collector_log": "resources/models/GRIM-text/training/logs/collector.log",
            "logs": "resources/models/GRIM-text/training/logs",
            "merge_checkpoints_exe": "resources/models/GRIM-text/DataCollection/Release/merge_checkpoints.exe",
            "model": "resources/models/GRIM-text/grim_text.bin",
            "source_config": "DataCollection/source_data.json",
            "training_data": "resources/models/GRIM-text/training/data/training_data.grmt",
            "training_status": "resources/models/GRIM-text/training/training_status.fb",
            "verified": "resources/models/GRIM-text/data/verified",
            "vocab": "resources/models/GRIM-text/training/data/vocab.bin"
        }
    },
    "personality": {
        "custom_prompt": "You are GRIM, a sarcastic but helpful AI assistant. Use dry humor and witty remarks while still providing accurate assistance. Don't be mean, just playfully sarcastic.",
        "use_custom_prompt": true
    },
    "silence_threshold": 0.02,
    "silence_timeout_ms": 4000,
    "tokenizer": {
        "add_bos": true,
        "add_eos": true,
        "enable_byte_fallback": true,
        "enable_lowercasing": true,
        "enable_nfkc_normalization": true,
        "enable_parallel_subword_mining": true,
        "enable_parallel_tokenization": true,
        "max_length": 2048,
        "max_vocab_size": 10000,
        "min_subword_freq": 3,
        "model_type": "unibytes",
        "parallel_threshold": 1000,
        "prune_during_mining": false,
        "save_text_vocab": true,
        "scratch_block_reasoning": {
            "detect_code_literals": true,
            "detect_dates": true,
            "detect_emails": true,
            "detect_numbers": true,
            "detect_paths": true,
            "detect_urls": true,
            "enabled": true
        },
        "subword_mining_max_bytes": 0,
        "subword_mining_workers": 0,
        "vocab_size": 10000
    },
    "training": {
        "config": {
            "activation_quantization": {
                "apply_to_embeddings": false,
                "apply_to_encoder_outputs": false,
                "apply_to_layer_caches": false,
                "apply_to_logits": false,
                "apply_to_qkv_cache": false,
                "clip_max": 127.0,
                "clip_min": -127.0,
                "enabled": false,
                "scale": 1.0,
                "symmetric": false,
                "zero_point": 0
