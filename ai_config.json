                "soft_restart": {
                    "cooldown_steps": 100000
                },
                "spike_thresholds": {
                    "mild": 3.0,
                    "moderate": 5.0,
                    "severe": 10.0
                },
                "volatility_damping": {
                    "max_damping": 0.9,
                    "threshold": 150.0
