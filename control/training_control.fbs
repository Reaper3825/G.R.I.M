// GRIM-text Training Control Protocol Schema
// FlatBuffer definition for training control communication
// Compile with: flatc --cpp training_control.fbs

namespace GRIMText.Control;

enum TrainingState:byte {
    Idle = 0,
    Collecting = 1,
    Verifying = 2,
    Training = 3,
    Paused = 4,
    Completed = 5,
    Error = 6
}

table TrainingStats {
    current_epoch:int = 0;
    total_epochs:int = 3;
    current_batch:int = 0;
    total_batches:int = 0;
    current_loss:float = 0.0;
    avg_loss:float = 0.0;
    perplexity:float = 0.0;
    tokens_per_sec:float = 0.0;
    gpu_memory_used:float = 0.0;
    gpu_memory_total:float = 0.0;
    training_progress:float = 0.0;
    collection_progress:float = 0.0;
    current_phase:string;
    last_error:string;
    start_time:int64 = 0;
    elapsed_time:int64 = 0;
}

table TrainingConfig {
    epochs:int = 3;
    batch_size:int = 8;
    learning_rate:float = 0.0001;
    max_seq_len:int = 8192;
    warmup_steps:int = 1000;
    use_gpu:bool = true;
    use_flash_attention:bool = true;
    data_path:string;
    vocab_path:string;
    output_path:string;
}

table StatusResponse {
    state:TrainingState = Idle;
    stats:TrainingStats;
    config:TrainingConfig;
    process_running:bool = false;
    timestamp:int64;
}

table StartTrainingRequest {
    config:TrainingConfig;
}

table StartTrainingResponse {
    success:bool;
    message:string;
    error:string;
}

table StopTrainingRequest {
}

table StopTrainingResponse {
    success:bool;
    message:string;
}

table UpdateConfigRequest {
    config:TrainingConfig;
}

table UpdateConfigResponse {
    success:bool;
    message:string;
    error:string;
}

table HealthCheckResponse {
    status:string;
    service:string;
    version:string;
}

table CheckpointInfo {
    path:string;
    size:int64;
    entry_count:int;
}

table CheckpointDetectRequest {
    checkpoint_dir:string;
}

table CheckpointDetectResponse {
    success:bool;
    checkpoint_count:int;
    total_entries:int;
    total_size:int64;
    checkpoints:[CheckpointInfo];
    message:string;
    error:string;
}

table CheckpointMergeRequest {
    checkpoint_dir:string;
    verified_dir:string;
    output_dir:string;
    skip_verification:bool = false;
}

table CheckpointMergeResponse {
    success:bool;
    message:string;
    error:string;
    checkpoint_entries:int;
    verified_entries:int;
    final_entries:int;
    output_grmt_path:string;
}

table DataCollectionRequest {
    mode:string;  // "full", "collect", "verify", "merge"
}

table DataCollectionResponse {
    success:bool;
    message:string;
    error:string;
}

root_type StatusResponse;
