# ============================================
*.7z
*.arrow
*.bz2
*.ftz
*.gz
*.joblib
*.lfs.*
*.mlmodel
*.msgpack
*.parquet
*.pickle
*.pkl
*.rar
*.tar
*.tar.*
*.tflite
*.tgz
*.wasm
*.xz
*.zip
*.zst
*tfevents*

# ============================================
# IDE specific
# ============================================
.idea/
**/.vscode/
*.code-workspace

# ============================================
