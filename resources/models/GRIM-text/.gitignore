# ============================================
# GRIM-text .gitignore
# ============================================

# ============================================
# Build outputs
# ============================================
**/build/
**/build_ninja/
**/Release/
**/Debug/
*.exe
*.dll
*.lib
*.obj
*.o
*.a
*.so
*.pdb
*.ilk
*.pch
*.idb
*.exp

# CMake generated
**/CMakeCache.txt
**/CMakeFiles/
**/cmake_install.cmake
Makefile
*.vcxproj*
*.sln

# Visual Studio
**/.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
x64/
x86/
[Bb]in/
[Oo]bj/
*.aps
*.ncb
*.opensdf
*.sdf
*.cachefile
*.vc.db
*.vc.opendb

# ============================================
# Training data (large files - NOT for repo)
# ============================================
training/data/
data/collected/
data/verified/

# ============================================
# Training logs (generated during runs)
# ============================================
training/logs/
*.log

# ============================================
# Model checkpoints and weights
# ============================================
checkpoints/
training/models/
*.bin
*.npz
*.npy
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.pb
*.h5
*.model
*.weights

# ============================================
# Quality verification models (DeBERTa ~2GB)
# ============================================
quality/

# ============================================
# Generated/cached files
# ============================================
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
training/third_party/

# Training status files (generated)
*.fb

# ============================================
# Temporary and output files
# ============================================
*.tmp
*.temp
*.bak
*.swp
*~
*.png
*.jpg
*.jpeg
stderr_output.txt
stderr_precheck.txt
tmp_*.txt
*_output.txt
*_crash.log
bad_sequences.log
train_gpu_crash.log

