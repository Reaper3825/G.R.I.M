// GRIM-text compiled hyperparameter artifact.
//
// This is the output contract for the independent configuration compiler. The
// compiler consumes human-authored model configuration, computes formula-derived
// values, validates the complete model contract, and writes one immutable
// artifact for train_gpu or another GRIM-text host.
//
// Design rules:
//   - This schema is not a binary image of LanguageModelConfig or any C++ ABI.
//   - Tables are organized by ownership domain, not by JSON field-name prefix.
//   - Optional feature tables are absent when the compiled model omits them.
//   - The artifact contains only model-semantic values. Training procedure,
//     optimizer/loss policy, batching, schedules, paths, runtime backend choices,
//     generation, logging, diagnostics, and telemetry belong in separate files.
//   - A change to a semantic field must imply model incompatibility and normally
//     requires retraining or loading a checkpoint compiled for the new contract.
//   - The loader must reject unsupported schema/semantic versions, malformed
//     digests, missing required tables, invalid enum sentinels, and failed
//     cross-field invariants before exposing any config view.

namespace GRIMConfig;

// ---------------------------------------------------------------------------
// Wire enums
//
// These values are the stable file-format contract. They intentionally do not
// depend on the numeric ordinals of C++ enums in HyperparameterEnums.hpp.
// ---------------------------------------------------------------------------

enum PositionalEncodingType : ubyte {
  Unspecified = 0,
  None = 1,
  Alibi = 2,
  Rope = 3,
  AlibiRope = 4
}

enum ModelCapability : ushort {
  Unknown = 0,
  Alibi = 1,
  Rope = 2,
  GroupedQueryAttention = 3,
  LayerScale = 4,
  QkNorm = 5,
  AttentionOffByOne = 6,
  AttentionResidualGate = 7,
  ExecutionBlock = 8,
  NumberEncoder = 9,
  ArgSelector = 10,
  SlotSeedEncoder = 11,
  LmHeadMlp = 12,
  AtomData = 13
}

// ---------------------------------------------------------------------------
// Artifact identity, integrity, and compatibility
// ---------------------------------------------------------------------------

table ConfigIntegrity {
  // SHA-256 over the complete serialized artifact after normalizing this
  // vector and both uint64 hashes to zero. Must contain exactly 32 bytes.
  // This makes verification independent of the source JSON and compiler.
  semantic_sha256:[ubyte] (required);

  // xxHash64 over the same normalized serialized artifact. This schema stores
  // model/checkpoint compatibility facts only, so the full semantic image is
  // also the compatibility image.
  model_compatibility_xxhash64:uint64;

  // Hash over the required capability vector in canonical numeric order.
  capability_xxhash64:uint64;
}

// ---------------------------------------------------------------------------
// Model architecture and compiler-derived geometry
// ---------------------------------------------------------------------------

table ArchitectureConfig {
  d_model:uint32;
  num_layers:uint32;
  num_heads:uint32;
  num_kv_heads:uint32;
  d_ff:uint32;
  max_seq_len:uint32;

  tie_embeddings:bool;
  embedding_scale:float32;
}

table DerivedArchitecture {
  head_dim:uint32;
  heads_per_kv_group:uint32;
  kv_dim:uint32;
  qkv_dim:uint32;
  rotary_dim:uint32;
  is_gqa:bool;

  attention_softmax_scale:float32;

  // Compiler-produced PBM lookup tables.
  pbm_alibi_slopes:[float32] (required);
  pbm_rope_inv_freq:[float32] (required);
}

// ---------------------------------------------------------------------------
// Model feature topology
// ---------------------------------------------------------------------------

table BiasPolicy {
  attention_qkv:bool;
  attention_output:bool;
  ffn_output:bool;
  lm_head:bool;
}

table AttentionConfig {
  causal_mask:bool = true;
  use_pre_norm:bool = true;
  fuse_qkv:bool = true;
  qk_norm_enabled:bool;
  off_by_one_enabled:bool;
  residual_gate_enabled:bool;
}

table PositionalEncodingConfig {
  kind:PositionalEncodingType = Unspecified;
  rope_base_seq_len:uint32;
  alibi_min_locality_distance:uint32;
  alibi_slope_exponent:float32;
  alibi_max_bias:float32;
  rope_theta:float32;
  rope_scaling:float32;
}

table EncoderConfig {
  rms_epsilon:float32;
  use_layer_scale:bool;
  center_residuals:bool;
}

table LmHeadConfig {
  unigram_bias_enabled:bool;
  center_hidden_states:bool;
  center_logits:bool;
  project_out_pc1:bool;
  pc1_power_iters:uint32;

  mlp_enabled:bool;
  mlp_d_ff:uint32;
  mlp_alpha:float32;
}

// Presence of this table means the compiled model contains ExecutionBlock.
table ExecutionBlockConfig {
  layer:int32 = -1;
  num_ops:uint32;
  num_slots:uint32;
  num_scratch_slots:uint32;
  num_steps:uint32;
  value_decode_input_dim:uint32;
  value_decode_hidden_dim:uint32;
  d_key:uint32;
  d_type:uint32;
  cross_attention_head_dim:uint32;
  cross_attention_top_k:uint32;

  usage_decay:float32;
  inject_gate_temperature:float32;
  result_slot_mode:uint32;
  result_slot_index:int32 = -1;
  magnitude_limit:float32;
  causal_w1_transition:float32;

  decode_bias_enabled:bool;
  value_embedding_bias_enabled:bool;
  scalar_bias_enabled:bool;
  trace_bias_enabled:bool;
}

// Presence of this table means the compiled model contains NumberEncoder.
table NumberEncoderConfig {
  max_digit_slots:uint32;
  d_hidden:uint32;
  max_abs_pow10:uint32;

  // Derived as 2 * max_abs_pow10 + 1.
  pow10_buckets:uint32;

  contribution_bias_enabled:bool;
  global_bias_enabled:bool;
}

// Presence of this table means the compiled model contains SlotSeedEncoder.
table SlotSeedEncoderConfig {
  d_hidden:uint32;
  bias_enabled:bool;
  type_embedding_enabled:bool;
}

table ModelFeatures {
  use_atom_data:bool;
  atom_embedding_dim:uint32;
  bias:BiasPolicy (required);
  attention:AttentionConfig (required);
  positional_encoding:PositionalEncodingConfig (required);
  encoder:EncoderConfig (required);
  lm_head:LmHeadConfig (required);

  // Optional topology components. Absence means the model omits the component.
  execution_block:ExecutionBlockConfig;
  number_encoder:NumberEncoderConfig;
  arg_selector_enabled:bool;
  slot_seed_encoder:SlotSeedEncoderConfig;
}

// ---------------------------------------------------------------------------
// Tokenizer behavior and reserved token-ID contract
// ---------------------------------------------------------------------------

table TokenizerConfig {
  model_type:string;

  special_tokens:[string] (required);
  add_bos:bool;
  add_eos:bool;
  unk_token:string;
  pad_token:string;
  bos_token:string;
  eos_token:string;
  unk_token_id:int32 = -1;
  pad_token_id:int32 = -1;
  bos_token_id:int32 = -1;
  eos_token_id:int32 = -1;
  enable_nfkc_normalization:bool;
  enable_lowercasing:bool;
  enable_byte_fallback:bool;

  enable_atom_reasoning:bool;
  detect_numbers:bool;
}

// ---------------------------------------------------------------------------
// Root artifact
// ---------------------------------------------------------------------------

table CompiledModelHyperparameters {
  // FlatBuffer wire shape version implemented by the loader.
  schema_version:uint32 = 2;

  // Identifies the formula/validation rules used to produce this artifact.
  // It is separate from schema_version because computations can change without
  // changing the FlatBuffer wire shape.
  semantic_version:uint32;

  integrity:ConfigIntegrity (required);

  required_capabilities:[ModelCapability] (required);

  architecture:ArchitectureConfig (required);
  derived_architecture:DerivedArchitecture (required);
  features:ModelFeatures (required);
  tokenizer:TokenizerConfig (required);
}

root_type CompiledModelHyperparameters;
file_identifier "GCFG";
file_extension "grimcfg";
